# Copie para .env (ou defina no "env" do claude_desktop_config.json)
IMAP_HOST=mail.empresa.com.br
IMAP_PORT=993
IMAP_SSL=true            # false => porta 143 com STARTTLS
SMTP_HOST=mail.empresa.com.br
SMTP_PORT=587
SMTP_SECURITY=starttls   # starttls | ssl (465) | none
MAIL_USER=usuario@empresa.com.br
MAIL_PASS=senha-ou-app-password
MAIL_FROM=Nome <usuario@empresa.com.br>
SENT_FOLDER=             # vazio = auto-detecta (\Sent, "Sent", "Itens Enviados"...)
ATTACH_DIR=                # vazio = %TEMP%\imap-mail-mcp (Windows) ou /tmp/imap-mail-mcp (Linux)
TLS_VERIFY=true          # false só para servidor interno com certificado self-signed
MAX_BODY_CHARS=20000

# --- Contas adicionais (opcional) ---
MAIL_ACCOUNT_NAME=principal        # apelido da conta acima
MAIL_ACCOUNTS_FILE=~/.imap-mail-accounts.json   # ver accounts.example.json
# ou inline:
# MAIL_ACCOUNTS=[{"name":"financeiro","user":"fin@empresa.com.br","password":"..."}]
